<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:eo="https://dfg-sos.github.io/ontologies/eo-formats#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:Ontology rdf:about="https://dfg-sos.github.io/ontologies/eo-formats">
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://dfg-sos.github.io/ontologies/releases/eo-formats/1.0.0/eo-formats.owl"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:publisher>DFG project SOS</dcterms:publisher>
    <rdfs:seeAlso rdf:resource="https://github.com/dfg-sos/ontologies"/>
    <dcterms:title>SOS Earth Observation file formats</dcterms:title>
    <dcterms:description>Taxonomy of Earth Observation / GIS file formats.</dcterms:description>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#documentation">
    <rdfs:label>documentation</rdfs:label>
    <rdfs:comment>Link to the specification or documentation of the format.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#fileExtension">
    <rdfs:label>file extension</rdfs:label>
    <rdfs:comment>A typical file extension of the format.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#mediaType">
    <rdfs:label>media type</rdfs:label>
    <rdfs:comment>Media type (MIME type) of the format.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#COG">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#GeoTIFF"/>
    <eo:documentation rdf:resource="https://docs.geoserver.org/latest/en/user/community/cog/cog.html"/>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-29T16:21:48.629321Z</oboInOwl:creation_date>
    <oboInOwl:hasDefinition>Regular GeoTIFF file that can be hosted on a HTTP file server. The use of  HTTP GET range requests lets clients ask for just the necessary portions of a GeoTIFF file.</oboInOwl:hasDefinition>
    <oboInOwl:hasExactSynonym>Cloud Optimized GeoTIFF</oboInOwl:hasExactSynonym>
    <rdfs:label>COG</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://gdal.org/drivers/raster/cog.html"/>
    <rdfs:seeAlso rdf:resource="https://www.cogeo.org/"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#DEM">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:fileExtension>.tif</eo:fileExtension>
    <eo:fileExtension>.tiff</eo:fileExtension>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T04:36:50.785363Z</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>Digital Elevation Model</oboInOwl:hasExactSynonym>
    <rdfs:label>DEM</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://docs.fileformat.com/gis/dem/"/>
    <rdfs:seeAlso rdf:resource="https://library.carleton.ca/guides/help/dem-formats"/>
    <rdfs:seeAlso rdf:resource="https://www.loc.gov/preservation/digital/formats/fdd/fdd000285.shtml"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#DSM">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:fileExtension>.tif</eo:fileExtension>
    <eo:fileExtension>.tiff</eo:fileExtension>
    <oboInOwl:created_by>mpataky</oboInOwl:created_by>
    <oboInOwl:creation_date>2026-02-15T21:00:20+01:00</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>Digital Surface Model</oboInOwl:hasExactSynonym>
    <rdfs:label>DSM</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://support.esri.com/en-us/gis-dictionary/digital-surface-model"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#DTM">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:fileExtension>.tif</eo:fileExtension>
    <eo:fileExtension>.tiff</eo:fileExtension>
    <oboInOwl:created_by>mpataky</oboInOwl:created_by>
    <oboInOwl:creation_date>2026-02-15T21:06:34+01:00</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>Digital Terrain Model</oboInOwl:hasExactSynonym>
    <rdfs:label>DTM</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://gdal.org/en/stable/tutorials/raster_dtm_tut.html"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#EsriJSON">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:fileExtension>.json</eo:fileExtension>
    <oboInOwl:created_by>mpataky</oboInOwl:created_by>
    <oboInOwl:creation_date>2026-02-15T21:17:34+01:00</oboInOwl:creation_date>
    <rdfs:seeAlso rdf:resource="https://support.esri.com/en-us/gis-dictionary/esri-json"/>
    <rdfs:label>Esri JSON</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GeoJSON">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:documentation rdf:resource="https://datatracker.ietf.org/doc/html/rfc7946"/>
    <eo:fileExtension>geojson</eo:fileExtension>
    <eo:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/geo+json"/>
    <rdfs:comment>Validator https://geojsonlint.com/</rdfs:comment>
    <rdfs:label>GeoJSON</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://geojson.org"/>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GeoJSON"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GeoPackage">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:documentation>https://www.geopackage.org/spec140/index.html</eo:documentation>
    <eo:fileExtension>.gpkg</eo:fileExtension>
    <oboInOwl:created_by>mpataky</oboInOwl:created_by>
    <oboInOwl:creation_date>2026-02-15T22:29:45+01:00</oboInOwl:creation_date>
    <rdfs:label>GeoPackage</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GeoParquet">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:documentation>https://geoparquet.org/</eo:documentation>
    <eo:fileExtension>.geoparquet</eo:fileExtension>
    <eo:fileExtension>.parquet</eo:fileExtension>
    <oboInOwl:created_by>mpataky</oboInOwl:created_by>
    <oboInOwl:creation_date>2026-02-15T22:44:12+01:00</oboInOwl:creation_date>
    <rdfs:label>GeoParquet</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GeoTIFF">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:documentation rdf:resource="https://gis-lab.info/docs/geotiff-1.8.2.pdf"/>
    <eo:fileExtension>.tif</eo:fileExtension>
    <eo:fileExtension>.tiff</eo:fileExtension>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-29T15:54:37.290778Z</oboInOwl:creation_date>
    <oboInOwl:hasDefinition>The GeoTIFF file format allows a TIFF file to be enriched with georeferencing metadata, such as map projections, coordinate systems, ellipsoids, and datums. With GeoTIFF, the raw pixels of an image can be stored and organized in particular ways.</oboInOwl:hasDefinition>
    <oboInOwl:hasExactSynonym>Geographic Tagged Image File Format</oboInOwl:hasExactSynonym>
    <rdfs:label>GeoTIFF</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GeoTIFF"/>
    <rdfs:seeAlso rdf:resource="https://github.com/OSGeo/libgeotiff"/>
    <rdfs:seeAlso rdf:resource="https://www.ogc.org/standards/geotiff"/>
    <skos:editorialNote>TODO: Is there a version-independent link to the documentation?</skos:editorialNote>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GeoZarr">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2023-12-13T22:32:43.63192Z</oboInOwl:creation_date>
    <rdfs:label>GeoZarr</rdfs:label>
    <skos:editorialNote>TODO: Is this the spec https://github.com/zarr-developers/geozarr-spec/blob/main/geozarr-spec.md ??? It is a fork of another repo!!!</skos:editorialNote>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GIS">
    <oboInOwl:hasExactSynonym>GIS Data</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>Geographical information format</oboInOwl:hasExactSynonym>
    <oboInOwl:hasNarrowSynonym>GIS file format</oboInOwl:hasNarrowSynonym>
    <rdfs:label>Geographical data format</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GIS_file_formats"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GML">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:fileExtension>gml</eo:fileExtension>
    <eo:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/gml+xml"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T11:59:54.522374Z</oboInOwl:creation_date>
    <rdfs:comment>Not to be confused with the Graph Modelling Language (also GML, with the same file extension).</rdfs:comment>
    <rdfs:label>GML (Geography Markup Language)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Geography_Markup_Language"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GPX">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:mediaType>application/gpx+xml (not in IANA)</eo:mediaType>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T04:29:11.969493Z</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>GPS Exchange Format</oboInOwl:hasExactSynonym>
    <rdfs:label>GPX</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GPS_Exchange_Format"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#GRIB">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:documentation rdf:resource="https://codes.wmo.int/def/_grib1"/>
    <eo:documentation rdf:resource="https://codes.wmo.int/def/grib2"/>
    <eo:fileExtension>gb</eo:fileExtension>
    <eo:fileExtension>grb</eo:fileExtension>
    <eo:fileExtension>grib</eo:fileExtension>
    <eo:fileExtension>grib1</eo:fileExtension>
    <eo:fileExtension>grib2</eo:fileExtension>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T13:42:00.666692Z</oboInOwl:creation_date>
    <oboInOwl:hasDefinition>Standard format for archiving and distributing gridded data, especially weather data. Since it is a binary format, that data is packed to increase storage efficiency. It is a collection of self-contained records of 2D data.</oboInOwl:hasDefinition>
    <oboInOwl:hasExactSynonym>GRIdded Binary</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>General Regularly distributed Information in Binary form</oboInOwl:hasExactSynonym>
    <rdfs:comment>GRIB is specific for weather data. Highly compressed (more than NetCDF). Standardised by the World Meteorological Organization, using two different coding standards: GRIB 1 and GRIB 2. A GRIB record must have a header, which describes that record, and the actual binary data itself.</rdfs:comment>
    <rdfs:label>GRIB</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GRIB"/>
    <rdfs:seeAlso rdf:resource="https://old.wmo.int/extranet/pages/prog/www/WMOCodes/Guides/GRIB/Introduction_GRIB1-GRIB2.pdf"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#KML">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:documentation rdf:resource="http://docs.opengeospatial.org/is/12-007r2/12-007r2.html"/>
    <eo:documentation rdf:resource="https://developers.google.com/kml/documentation/kmlreference"/>
    <oboInOwl:hasExactSynonym>Keyhole Markup Language</oboInOwl:hasExactSynonym>
    <rdfs:comment>KML was developed for Google Earth (former Keyhole Earth Viewer), and standardised by the Open Geospatial Consortium (OGC, OpenGIS, https://en.wikipedia.org/wiki/OpenGIS).</rdfs:comment>
    <rdfs:label>KML</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Keyhole_Markup_Language"/>
    <rdfs:seeAlso rdf:resource="https://www.ogc.org/standards/kml/"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#NetCDF_CF">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <oboInOwl:comment>From version-4 NetCDF is based on HDF5</oboInOwl:comment>
    <oboInOwl:hasExactSynonym>NetCDF CF conventions</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>NetCDF following the CF metadata conventions</oboInOwl:hasExactSynonym>
    <rdfs:comment>NetCDF-CF is used also for generic geospatial data, not only climate and weather data.</rdfs:comment>
    <rdfs:label>NetCDF-CF</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Climate_and_Forecast_Metadata_Conventions"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#OSM_JSON">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T13:21:22.310231Z</oboInOwl:creation_date>
    <rdfs:comment>How related to https://wiki.openstreetmap.org/wiki/Overpass_JSON?</rdfs:comment>
    <rdfs:label>OSM JSON</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#OSM_XML">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T04:33:21.310981Z</oboInOwl:creation_date>
    <oboInOwl:hasBroadSynonym>OpenStreetMap File Formats</oboInOwl:hasBroadSynonym>
    <oboInOwl:hasExactSynonym>OSM Formats</oboInOwl:hasExactSynonym>
    <rdfs:comment>TODO recommended to use binary PBF format instead</rdfs:comment>
    <rdfs:label>OSM XML</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://docs.fileformat.com/gis/osm/"/>
    <rdfs:seeAlso rdf:resource="https://wiki.openstreetmap.org/wiki/OSM_file_formats"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#PBF">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:fileExtension>osm.pbf</eo:fileExtension>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-26T13:25:05.495509Z</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>OSM PBF</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>OpenStreetMap Protocolbuffer Binary Format</oboInOwl:hasExactSynonym>
    <rdfs:label>PBF</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://wiki.openstreetmap.org/wiki/PBF_Format"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#Raster">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#GIS"/>
    <oboInOwl:hasNarrowSynonym>Grid format</oboInOwl:hasNarrowSynonym>
    <rdfs:label>Raster (GIS)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GIS_file_formats#Raster"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#Shapefile">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <eo:documentation rdf:resource="https://www.esri.com/content/dam/esrisites/sitecore-archive/Files/Pdfs/library/whitepapers/pdfs/shapefile.pdf"/>
    <eo:documentation rdf:resource="https://www.loc.gov/preservation/digital/formats/fdd/fdd000280.shtml"/>
    <eo:fileExtension>dbf</eo:fileExtension>
    <eo:fileExtension>shp</eo:fileExtension>
    <eo:fileExtension>shx</eo:fileExtension>
    <eo:mediaType>x-gis/x-shapefile (not in IANA)</eo:mediaType>
    <rdfs:comment>Shapefile is a composite format including 3 mandatory files: binary shape/geometry file .shp, shape/geometry index file .shx, and a textual attribute format .dbf). It may contain additional optional files, mostly binary (x-gis/x-shapefile), but some textual or XML.</rdfs:comment>
    <rdfs:label>Shapefile</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://docs.fileformat.com/gis/shp"/>
    <rdfs:seeAlso rdf:resource="https://docs.fileformat.com/gis/shx"/>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Shapefile"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#Vector">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#GIS"/>
    <rdfs:label>Vector (GIS)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/GIS_file_formats#Vector"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#VRT">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <eo:fileExtension>vrt</eo:fileExtension>
    <oboInOwl:created_by>melibleq</oboInOwl:created_by>
    <oboInOwl:creation_date>2021-08-29T16:08:38.496836Z</oboInOwl:creation_date>
    <oboInOwl:hasDefinition>GDAL Virtual Dataset. XML format that maps its attributes and geometries to that of an underlying data source of any GDAL-supported raster format. It transforms features read from other drivers based on criteria specified in an XML control file. It is primarily used to derive spatial layers from flat tables with spatial information in attribute columns. It can also be used to associate coordinate system information with a datasource, merge layers from different datasources into a single data source, or even just to provide an anchor file for access to non-file oriented datasources.</oboInOwl:hasDefinition>
    <oboInOwl:hasExactSynonym>GDAL Virtual Format</oboInOwl:hasExactSynonym>
    <rdfs:label>VRT</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://gdal.org/drivers/vector/vrt.html"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#WKB">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2022-05-06T08:30:52.099751Z</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>Well-known binary representation of geometry</oboInOwl:hasExactSynonym>
    <rdfs:comment>Binary version of WKT</rdfs:comment>
    <rdfs:label>WKB</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry#Well-known_binary"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#WKT">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Vector"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2022-05-06T08:27:51.757844Z</oboInOwl:creation_date>
    <oboInOwl:hasExactSynonym>Well-known textual representation of geometry</oboInOwl:hasExactSynonym>
    <rdfs:label>WKT</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Well-known_text_representation_of_geometry"/>
  </owl:Class>
  <owl:Class rdf:about="https://dfg-sos.github.io/ontologies/eo-formats#XDMF">
    <rdfs:subClassOf rdf:resource="https://dfg-sos.github.io/ontologies/eo-formats#Raster"/>
    <oboInOwl:created_by>Matúš Kalaš</oboInOwl:created_by>
    <oboInOwl:creation_date>2022-05-06T08:36:05.937701Z</oboInOwl:creation_date>
